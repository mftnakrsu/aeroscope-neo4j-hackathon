# Neo4j Aura
# Get these from https://console.neo4j.io/ after creating a free instance
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# OpenAI (for synthetic corpus generation, entity extraction, enrichment, implicit linking)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Supabase — auth (email/password + Google OAuth)
# From Supabase Dashboard → Project Settings → API
# Google OAuth: Dashboard → Authentication → Providers → Google
# Redirect URL to configure in Google console:
#   https://<your-project>.supabase.co/auth/v1/callback
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
